# Local MongoDB. Replace with your MongoDB Atlas URI for a hosted database.
MONGO_URI=mongodb://127.0.0.1:27017/smartproductivity

# Generate a unique secret for each environment; do not commit backend/.env.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
COOKIE_SECURE=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

NODE_ENV=development
PORT=6000
FRONTEND_URL=http://localhost:4000

# Optional delivery for account verification and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Stripe billing (create Price IDs in your Stripe dashboard).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# Configurable Free plan limits.
FREE_TASK_LIMIT=50
FREE_PROJECT_LIMIT=3
FREE_FOCUS_SESSIONS_PER_DAY=5
FREE_ANALYTICS_DAYS=7

# Optional demo account overrides for `npm run seed` (development only).
DEMO_USER_EMAIL=student@smartproductivity.local
DEMO_USER_PASSWORD=
DEMO_ADMIN_EMAIL=admin@smartproductivity.local
DEMO_ADMIN_PASSWORD=
